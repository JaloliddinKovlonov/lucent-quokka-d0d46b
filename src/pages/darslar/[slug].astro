---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const lessons = await getCollection('lessons', l => l.data.published);
  return lessons.map(l => ({ params: { slug: l.id }, props: { lesson: l } }));
}
const { lesson } = Astro.props;
const { Content } = await render(lesson);
const all = (await getCollection('lessons', l => l.data.published)).sort((a,b)=>a.data.order-b.data.order);
const i = all.findIndex(l => l.id === lesson.id);
const prev = all[i-1], next = all[i+1];
---
<Base title={lesson.data.title + ' — uzdevops.uz'}>
<div class="wrap" style="max-width:860px">
  <a href="/darslar" style="display:inline-block;font-size:14px;margin:28px 0 14px;text-decoration:none;color:color-mix(in srgb,var(--color-text) 64%,transparent)">← Barcha darslar</a>
  <header style="padding:14px 0 8px">
    <span class="kicker">{String(lesson.data.order).padStart(2,'0')} · {lesson.data.category} · {lesson.data.duration}</span>
    <h1 style="font-size:clamp(30px,3.6vw,44px)">{lesson.data.title}</h1>
    <p style="font-size:16px;line-height:28px;max-width:58ch;color:color-mix(in srgb,var(--color-text) 78%,transparent)">{lesson.data.description}</p>
  </header>
  {lesson.data.video && (
    <div style="aspect-ratio:16/9;border-radius:var(--radius-md);overflow:hidden;border:1px solid var(--color-neutral-700);margin:28px 0 42px;background:var(--color-neutral-900)">
      <iframe src={lesson.data.video} title={lesson.data.title} style="width:100%;height:100%;border:0" allowfullscreen></iframe>
    </div>
  )}
  <article class="lesson"><Content /></article>
  <div style="display:flex;justify-content:space-between;gap:16px;border-top:1px solid var(--color-divider);padding:28px 0 24px;margin-top:42px">
    {prev ? <a class="btn btn-ghost" href={'/darslar/' + prev.id}>← {prev.data.title}</a> : <span />}
    {next ? <a class="btn" href={'/darslar/' + next.id}>Keyingi: {next.data.title} →</a> : <a class="btn" href="/darslar">Barcha darslar</a>}
  </div>
</div>
</Base>
